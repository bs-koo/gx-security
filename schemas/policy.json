{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gx-security.local/schemas/policy.json",
  "title": "gx-security independently trusted policy v1",
  "description": "Load explicitly from protected input outside the inspected repository. Project profiles cannot supply this object.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "check",
        "static-release",
        "release",
        "source-review"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope_hash": {
      "type": "string",
      "minLength": 1
    },
    "required_reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trusted_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "digest",
          "kind",
          "roles"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "manual-review",
              "finding-review",
              "finding-validation",
              "finding-refutation",
              "risk-acceptance",
              "not-applicable",
              "release-evidence",
              "dependency-provenance",
              "framework-baseline"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "framework_baseline": {
      "type": "object",
      "description": "Protected digest-approved observed manifest; comparison does not approve findings."
    },
    "require_framework_baseline": {
      "type": "boolean"
    },
    "release_evidence": {
      "type": "object",
      "required": [
        "id",
        "source_revision",
        "artifact_digest",
        "clean_checkout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "minLength": 1
        },
        "clean_checkout": {
          "const": true
        }
      }
    },
    "sca": {
      "type": "object",
      "required": [
        "offline_db",
        "db_manifest_sha256",
        "provenance"
      ],
      "properties": {
        "offline_db": {
          "type": "string"
        },
        "db_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "object",
          "required": [
            "id",
            "source_revision",
            "scope_hash",
            "input_hashes",
            "runtime_complete",
            "modules",
            "artifact_digest"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "source_revision": {
              "type": "string"
            },
            "scope_hash": {
              "type": "string"
            },
            "input_hashes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "runtime_complete": {
              "const": true
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artifact_digest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
